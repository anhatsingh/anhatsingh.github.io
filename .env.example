# Copy to .env.local and fill in. Everything here is optional for local dev —
# the site renders from seed content with no env at all, and each feature
# degrades to a clear message rather than an error when its key is missing.

# --- Chatbot (required for chat + UI control) -------------------------------
# console.openai.com → API keys. Tool-calling reliability is why this is OpenAI
# rather than Cerebras: the page navigation depends on well-formed tool calls.
OPENAI_API_KEY=
# Check OpenAI's current model list rather than trusting this default — their
# cheap tool-calling tier gets renamed every few months.
OPENAI_MODEL=gpt-4o-mini

# --- Supabase (required for admin panel + editable content) -----------------
# supabase.com → new project → Settings → API.
# Run lib/db/schema.sql in the SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role BYPASSES row-level security. Server-only. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated. An EMPTY value denies everyone — this fails closed on
# purpose, so a half-configured deploy can't become an open admin panel.
ADMIN_EMAILS=

# --- GitHub stats (optional; section hides itself without it) ---------------
# A classic PAT with NO scopes is enough for public data. The contribution
# calendar is GraphQL-only, and GraphQL rejects unauthenticated requests
# entirely — hence the token.
GH_STATS_PAT=

# --- Contact form + in-chat messages (optional) -----------------------------
# resend.com → API keys. Without these, messages still persist to Supabase.
RESEND_API_KEY=
CONTACT_EMAIL=
# Must be a domain verified in Resend, or leave blank to use their sandbox sender.
CONTACT_FROM=

# --- SEO (optional) ---------------------------------------------------------
# From Google Search Console -> add property -> HTML tag method. Paste only the
# content value, not the whole meta tag. Needed once to prove you own the
# domain; after that Search Console is how you see whether you're actually
# indexed rather than guessing.
GOOGLE_SITE_VERIFICATION=

# --- Resume compilation (optional locally, required on Vercel) --------------
# Vercel functions can't host a TeX installation. Unset, lib/resume/compile.ts
# shells out to a local pdflatex instead, which is what development and
# `npm run verify:resume-pdf` use. Deploy infra/latex to Cloud Run and point
# this at it — see infra/latex/README.md.
LATEX_SERVICE_URL=
# The service accepts anything when it has no token set, so an
# allow-unauthenticated Cloud Run URL without one is an open compile endpoint.
LATEX_SERVICE_TOKEN=

# --- Cloud Run logs in the admin (optional) ---------------------------------
# The compile trail the container returns explains anything it was alive to
# report. It cannot explain a container killed for memory or a request that
# timed out at the front door — those live only in Cloud Logging, and
# /admin/resume will fetch them on demand given a service account with
# roles/logging.viewer and nothing more.
#
# Unset, the compile trail still shows and the panel says logs aren't set up.
GCP_PROJECT_ID=
# The entire key file, braces included. A key that loses its newlines being
# pasted in is the usual failure; `npm run check-env` catches it.
GCP_SERVICE_ACCOUNT_JSON=
# Only if you renamed the Cloud Run service. Defaults to latex-compiler.
GCP_LATEX_SERVICE_NAME=
